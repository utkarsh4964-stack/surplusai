# Copy this file to .env and fill in the keys you want to enable.
# Both are OPTIONAL - the app works with neither set, using its
# built-in heuristic/formula fallbacks instead.

# Enables real image-based freshness scoring in the Quality Agent
# (falls back to the deterministic heuristic if unset).
GROQ_API_KEY=

# Enables real driving/route ETA in the Route Agent via Google Maps
# Directions API (falls back to the distance/speed formula if unset).
GOOGLE_MAPS_API_KEY=
